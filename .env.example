# Kopiere diese Datei nach .env und trage deinen Namen und deine echte E-Mail-Adresse ein.
# Die SEC verlangt einen aussagekräftigen User-Agent mit Kontaktadresse (SEC Fair Access Policy).
SEC_USER_AGENT=Vorname Nachname deine.email@beispiel.ch

# Optional
# Max. Anfragen pro Sekunde an die SEC (Obergrenze laut SEC: 10)
SEC_REQUESTS_PER_SECOND=5
# Wie lange heruntergeladene Daten als aktuell gelten (Tage)
MAX_CACHE_AGE_DAYS=7
# Geschäftsjahre (Bereich oder Liste)
FISCAL_YEARS=2021-2025
# Rohdaten (komprimiert, ca. 1-2 GB) für schnelle Neuverarbeitung behalten
KEEP_RAW_CACHE=true
# Datenordner (relativ zum Projektordner oder absolut)
DATA_DIR=data
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=5

# Machine Learning
# Trainingsjahre (Bilanzen); XBRL-Daten der SEC gibt es ab ca. 2009
ML_YEARS=2010-2025
# Prognosehorizont in Kalendertagen ab Veröffentlichung des 10-K
ML_HORIZON_DAYS=365

# Gamma Exposure (AnalyticsFX-API, https://www.analytics-fx.com/dashboard/api) – Schlüssel nur hier eintragen
ANALYTICSFX_API_KEY=
# Symbole für den täglichen GEX-Abruf (Options-Wurzeln, z. B. SPY, QQQ, SPX)
GEX_SYMBOLS=SPY,QQQ,SPX
